# Keep the build context small and free of secrets / local state.
.git
.github
.next
node_modules
npm-debug.log*
*.tsbuildinfo
next-env.d.ts

# secrets / env
.env
.env*
!.env.example
*.pem

# notes and design sources: the build needs no top-level docs
/*.md
/*.txt
blender
*.blend
*.blend1

# infra lives beside the app but isn't part of the image
Dockerfile
.dockerignore
deploy
infra
docs
